# Copy this file to .env and fill in real values. Never commit the real .env file.

# MySQL connection string: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://kesec_user:kesec_password@localhost:3306/kesec

# Secret used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-value

# How long a login session stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Key used to encrypt/decrypt stored secret passwords. Must be a valid Fernet key.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this key is ever lost, every stored password becomes permanently unreadable.
# If it ever leaks, every stored password can be decrypted. Treat it like a master key.
ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
