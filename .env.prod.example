# Copy this file to .env (at the repo root) and fill in real values.
# This file is read automatically by `docker compose -f docker-compose.prod.yml ...`
# Never commit the real .env file.

# Your domain, pointed at this VM's IP via an A record.
# If you don't have a domain yet, leave this as your VM's IP address -
# Caddy will serve plain HTTP (no automatic HTTPS is possible without a
# real domain, since Let's Encrypt validates ownership via DNS).
DOMAIN=your-domain.com

# Generate strong, unique passwords - these are not the same as your
# personal kesec login, they're the MySQL server's own credentials.
#   openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Same two keys as backend/.env - generate fresh ones for production,
# don't reuse whatever you used locally.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-value

#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-generated-fernet-key

ACCESS_TOKEN_EXPIRE_MINUTES=1440
